config {
  type:"incremental",
  name:"stg_product",
  dataset:"stg_pancake",
  tags:["stage", "pancake"],
  dependencyTargets:[{
    name:"raw_product_variations"
  }],
}
SELECT DISTINCT
  TIMESTAMP_TRUNC(_PARTITIONTIME, DAY) AS proc_date,
  DATETIME(PARSE_TIMESTAMP('%Y%m%d%H%M%S', inserted_at))  AS inserted_at,
  DATETIME(PARSE_TIMESTAMP('%Y%m%d%H%M%S', updated_at))  AS updated_at,
  product_id,
  product_display_id AS display_id, 
  TRIM(product_name) AS product_name, 
  product_attributes, 
  product_supplier_product_ids AS supplier_product_ids,
  product_tags
FROM ${ref("raw_product_variations")}
WHERE TIMESTAMP_TRUNC(_PARTITIONTIME, DAY) = TIMESTAMP(CURRENT_DATE("Asia/Ho_Chi_Minh"))