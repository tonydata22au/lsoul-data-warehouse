config {
  type:"incremental",
  name:"stg_thai_reporting_basic_auction_ad",
  dataset:"stg_tiktok",
  dependencyTargets:[{
    name:"raw_tiktok_thai_reporting_basic_auction_ad"
  }],
}
SELECT
DATE(TIMESTAMP_TRUNC(_PARTITIONTIME, DAY)) AS proc_date,
ad_id, 
country_code, 
SAFE_CAST(stat_time_day AS DATE) AS inserted_at, 
SAFE_CAST(spend AS NUMERIC) AS spend, 
SAFE_CAST(cpc AS INT64) AS cpc, 
SAFE_CAST(cpm AS NUMERIC) AS cpm, 
SAFE_CAST(impressions  AS INT64) AS impressions,
SAFE_CAST(gross_impressions AS INT64) AS gross_impressions,
SAFE_CAST(clicks AS INT64) AS clicks,
SAFE_CAST(ctr AS FLOAT64) AS ctr,
SAFE_CAST(reach  AS INT64) AS reach,
SAFE_CAST(frequency AS FLOAT64) AS frequency,
SAFE_CAST(result AS INT64) AS result,
SAFE_CAST(cost_per_result AS FLOAT64) AS cost_per_result,
SAFE_CAST(result_rate AS FLOAT64) AS result_rate,
SAFE_CAST(real_time_result AS INT64) AS real_time_result,
SAFE_CAST(real_time_cost_per_result AS FLOAT64) AS real_time_cost_per_result,
SAFE_CAST(real_time_result_rate AS FLOAT64) AS real_time_result_rate,
SAFE_CAST(video_play_actions AS INT64) AS video_play_actions,
SAFE_CAST(video_watched_2s AS INT64) AS video_watched_2s,
SAFE_CAST(video_watched_6s AS INT64) AS video_watched_6s,
SAFE_CAST(average_video_play AS FLOAT64) AS average_video_play,
SAFE_CAST(video_views_p25 AS INT64) AS video_views_p25,
SAFE_CAST(video_views_p50 AS INT64) AS video_views_p50,
SAFE_CAST(video_views_p75  AS INT64) AS video_views_p75,
SAFE_CAST(video_views_p100  AS INT64) AS video_views_p100,
SAFE_CAST(engaged_view AS INT64) AS engaged_view,
SAFE_CAST(engaged_view_15s AS INT64) AS engaged_view_15s,
SAFE_CAST(follows AS INT64) AS follows,
SAFE_CAST(likes AS INT64) AS likes,
SAFE_CAST(comments AS INT64) AS comments,
SAFE_CAST(shares AS INT64) AS shares,
SAFE_CAST(profile_visits AS INT64) AS profile_visits,
SAFE_CAST(profile_visits_rate AS FLOAT64) AS profile_visits_rate,
SAFE_CAST(live_product_clicks AS INT64) AS live_product_clicks,
SAFE_CAST(total_landing_page_view AS INT64) AS total_landing_page_view,
SAFE_CAST(cost_per_landing_page_view AS INT64) AS cost_per_landing_page_view,
SAFE_CAST(landing_page_view_rate AS FLOAT64) AS landing_page_view_rate,
FROM ${ref("raw_tiktok_thai_reporting_basic_auction_ad")}
WHERE TIMESTAMP_TRUNC(_PARTITIONTIME, DAY) = TIMESTAMP(CURRENT_DATE("Asia/Ho_Chi_Minh"))