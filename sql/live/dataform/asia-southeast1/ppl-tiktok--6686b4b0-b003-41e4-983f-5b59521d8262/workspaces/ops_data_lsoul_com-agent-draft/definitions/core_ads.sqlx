config {
  type:"table",
  name:"core_ads",
  dataset:"core_tiktok",
  dependencyTargets:[],
}
SELECT
proc_date,
create_time,
modify_time,
ad_id,
ad_name,
operation_status,
secondary_status,
app_name,
advertiser_id,
campaign_id,
campaign_name,
adgroup_id,
adgroup_name,
display_name,
optimization_event,
ad_format,
creative_type,
ad_text,
tiktok_item_id,
identity_type,
campaign_automation_type
FROM ${ref("stg_ads")}
WHERE DATE(proc_date) = CURRENT_DATE("Asia/Ho_Chi_Minh")



