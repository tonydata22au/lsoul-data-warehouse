config {
  type:"incremental",
  name:"core_reporting_basic_auction_ad",
  dataset:"core_tiktok",
  dependencyTargets:[{
    name:"stg_reporting_basic_auction_ad"
  }],
}
SELECT DISTINCT
inserted_at,
ad_id, 
country_code, 
spend, 
cpc, 
cpm, 
impressions,
gross_impressions,
clicks,
ctr,
reach,
frequency,
result,
cost_per_result,
result_rate,
real_time_result,
real_time_cost_per_result,
real_time_result_rate,
video_play_actions,
video_watched_2s,
video_watched_6s,
average_video_play,
video_views_p25,
video_views_p50,
video_views_p75,
video_views_p100,
engaged_view,
engaged_view_15s,
follows,
likes,
comments,
shares,
profile_visits,
profile_visits_rate,
live_product_clicks,
total_landing_page_view,
cost_per_landing_page_view,
landing_page_view_rate
FROM ${ref("stg_reporting_basic_auction_ad")}
WHERE DATE(proc_date) = CURRENT_DATE("Asia/Ho_Chi_Minh")