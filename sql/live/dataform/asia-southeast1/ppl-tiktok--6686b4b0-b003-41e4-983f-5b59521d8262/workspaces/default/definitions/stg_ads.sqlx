config {
  type:"table",
  name:"stg_ads",
  dataset:"stg_tiktok",
  dependencyTargets:[{
    name:"raw_tiktok_ads"
  }],
}
SELECT
DATE(TIMESTAMP_TRUNC(_PARTITIONTIME, DAY)) AS proc_date,
DATETIME(PARSE_TIMESTAMP('%Y%m%d%H%M%S', create_time))  AS create_time,
DATETIME(PARSE_TIMESTAMP('%Y%m%d%H%M%S', modify_time))  AS modify_time,
ad_id,
ad_name,
operation_status,
secondary_status,
app_name,
advertiser_id,
campaign_id,
campaign_name,
adgroup_id,
adgroup_name,
display_name,
optimization_event,
ad_format,
creative_type,
ad_text,
tiktok_item_id,
identity_type,
campaign_automation_type
FROM ${ref("raw_tiktok_ads")}
WHERE TIMESTAMP_TRUNC(_PARTITIONTIME, DAY) = TIMESTAMP(CURRENT_DATE("Asia/Ho_Chi_Minh"))