config {
  type:"incremental",
  name:"stg_magento_order",
  dependencyTargets:[{
    name:"raw_magento_order"
  }],
}
SELECT
TIMESTAMP_TRUNC(_PARTITIONTIME, DAY) AS proc_date,
DATETIME(PARSE_TIMESTAMP('%Y%m%d%H%M%S', created_at))  AS created_at,
DATETIME(PARSE_TIMESTAMP('%Y%m%d%H%M%S', updated_at))  AS updated_at,
increment_id,
SAFE_CAST(entity_id AS INT64) AS entity_id,
order_currency_code,
state,
status,
customer_email,
customer_firstname,
customer_lastname,
SAFE_CAST(customer_group_id AS INT64) AS customer_group_id,
SAFE_CAST(customer_is_guest AS INT64) AS customer_is_guest,
SAFE_CAST(customer_note_notify AS INT64) AS customer_note_notify,
SAFE_CAST(email_sent AS INT64) AS email_sent,
SAFE_CAST(is_virtual AS INT64) AS is_virtual,
remote_ip,
SAFE_CAST(store_id AS INT64) AS store_id,
store_currency_code,
store_name,
shipping_description,
SAFE_CAST(shipping_amount AS FLOAT64) AS shipping_amount,
SAFE_CAST(shipping_tax_amount AS FLOAT64) AS shipping_tax_amount,
SAFE_CAST(discount_amount AS FLOAT64) AS discount_amount,
SAFE_CAST(subtotal AS FLOAT64) AS subtotal,
SAFE_CAST(total_paid AS FLOAT64) AS total_paid,
SAFE_CAST(total_due AS FLOAT64) AS total_due,
SAFE_CAST(grand_total AS FLOAT64) AS grand_total,
SAFE_CAST(total_item_count AS NUMERIC) AS total_item_count,
SAFE_CAST(total_qty_ordered AS NUMERIC) AS total_qty_ordered,
SAFE_CAST(items_item_id AS INT64) AS item_id,
SAFE_CAST(items_product_id AS INT64) AS product_id,
SAFE_CAST(items_parent_item_id AS INT64) AS parent_item_id,
items_sku,
items_name,
SAFE_CAST(items_free_shipping AS INT64) AS is_free_shipping,
SAFE_CAST(items_qty_ordered AS NUMERIC) AS qty_ordered,
SAFE_CAST(items_qty_canceled AS NUMERIC) AS qty_canceled,
SAFE_CAST(items_qty_refunded AS NUMERIC) AS qty_refunded,
SAFE_CAST(items_qty_shipped AS NUMERIC) AS qty_shipped,
SAFE_CAST(items_no_discount AS NUMERIC) AS no_discount,
SAFE_CAST(items_discount_percent AS FLOAT64) AS discount_percent,
SAFE_CAST(items_amount_refunded AS FLOAT64) AS amount_refunded,
SAFE_CAST(items_discount_amount AS FLOAT64) AS item_discount_amount,
SAFE_CAST(items_original_price AS FLOAT64) AS original_price,
SAFE_CAST(items_price AS FLOAT64) AS retail_price,
SAFE_CAST(items_price_incl_tax AS FLOAT64) AS retail_price_incl_tax,
SAFE_CAST(items_tax_amount AS FLOAT64) AS tax_amount,
SAFE_CAST(items_tax_percent AS FLOAT64) AS tax_percent,
SAFE_CAST(items_row_total_incl_tax AS FLOAT64) AS total_amount_incl_tax,
SAFE_CAST(items_row_total AS FLOAT64) AS total_amount,
billing_address_billing,
SAFE_CAST(billing_address_entity_id AS NUMERIC) AS billing_address_entity_id,
SAFE_CAST(billing_address_parent_id AS NUMERIC) AS billing_address_parent_id,
billing_address_email,
billing_address_firstname,
billing_address_lastname,
billing_address_telephone,
billing_address_street,
billing_address_city,
billing_address_postcode,
billing_address_region_code,
billing_address_region,
billing_address_country_id,
SAFE_CAST(payment_parent_id AS INT64) AS payment_parent_id,
payment_account_status,
payment_method,
SAFE_CAST(payment_shipping_amount AS FLOAT64) AS payment_shipping_amount,
SAFE_CAST(payment_shipping_captured AS FLOAT64) AS payment_shipping_captured,
SAFE_CAST(payment_amount_authorized AS FLOAT64) AS payment_amount_authorized,
SAFE_CAST(payment_amount_ordered AS FLOAT64) AS payment_amount_ordered,
SAFE_CAST(payment_amount_paid AS FLOAT64) AS payment_amount_paid,
mp_extra_fee
FROM ${ref("raw_magento_order")}
WHERE TIMESTAMP_TRUNC(_PARTITIONTIME, DAY) = TIMESTAMP(CURRENT_DATE("Asia/Ho_Chi_Minh"))