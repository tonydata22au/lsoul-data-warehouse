config {
  type:"incremental",
  name:"core_dianplus_order_item",
  dependencyTargets:[{
    name:"stg_dianplus_order"
  }],
}
SELECT
  inserted_at,
  MAX(lastModifyTime) AS lastModifyTime,
  brandId,
  orderId,
  payTime,
  orderType,
  orderStatus,
  payStatus,
  order_source_id,
  order_system_source_id,
  orderItems_orderItemId    AS orderItemId,
  orderItems_spuDjId        AS spuDjId,
  orderItems_spuCode        AS spuCode,
  orderItems_skuDjId        AS skuDjId,
  REGEXP_EXTRACT(orderItems_skuCode, r'^([^-]+)') AS product_code,
   DATE(
    SAFE_CAST(SUBSTR(REGEXP_EXTRACT(orderItems_skuCode, r'\d{6}'), 1, 2) AS INT64) + 2000,
    SAFE_CAST(SUBSTR(REGEXP_EXTRACT(orderItems_skuCode, r'\d{6}'), 3, 2) AS INT64),
    01
    ) product_launch_date,
  orderItems_skuCode        AS skuCode,
  orderItems_skuName        AS skuName,
  orderItems_colorCode      AS colorCode,
  orderItems_colorName      AS colorName,
  orderItems_sizeCode       AS sizeCode,
  orderItems_sizeName       AS sizeName,
  orderItems_amount         AS amount,
  orderItems_suggestPrice   AS suggestPrice,
  orderItems_salePrice      AS salePrice,
  orderItems_dealPrice      AS dealPrice,
  orderItems_sumSuggestPrice AS sumSuggestPrice,
  orderItems_sumSalePrice    AS sumSalePrice,
  orderItems_sumDealPrice    AS sumDealPrice,
  orderItems_saleStaffDjId   AS saleStaffDjId,
  orderItems_saleStaffCode   AS saleStaffCode,
  orderItems_itemPayInfos_payMethodCode AS payMethodCode,
  orderItems_itemPayInfos_payMethodDesc AS payMethodDesc,
  orderItems_itemPayInfos_custPayMethodCode AS custPayMethodCode,
  orderItems_itemPayInfos_custPayMethodName AS custPayMethodName,
  orderItems_itemPayInfos_amt AS payAmt,
  orderItems_itemPayInfos_totalAmt AS payTotalAmt
  FROM ${ref("stg_dianplus_order")}
  WHERE DATE(proc_date) = CURRENT_DATE()
  GROUP BY
  inserted_at,
  brandId,
  orderId,
  payTime,
  orderType,
  orderStatus,
  payStatus,
  order_source_id,
  order_system_source_id,
  orderItemId,
  spuDjId,
  spuCode,
  skuDjId,
  product_code,
  product_launch_date,
  skuCode,
  skuName,
  colorCode,
  colorName,
  sizeCode,
  sizeName,
  amount,
  suggestPrice,
  salePrice,
  dealPrice,
  sumSuggestPrice,
  sumSalePrice,
  sumDealPrice,
  saleStaffDjId,
  saleStaffCode,
  payMethodCode,
  payMethodDesc,
  custPayMethodCode,
  custPayMethodName,
  payAmt,
  payTotalAmt
