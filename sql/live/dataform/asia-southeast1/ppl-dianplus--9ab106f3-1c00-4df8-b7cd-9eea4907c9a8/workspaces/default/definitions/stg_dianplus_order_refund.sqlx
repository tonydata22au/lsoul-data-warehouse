config {
  type:"incremental",
  name:"stg_dianplus_order_refund",
  dependencyTargets:[{
    name:"raw_dianplus_order_refund"
  }],
}
SELECT
TIMESTAMP_TRUNC(_PARTITIONTIME, DAY) AS proc_date,
DATETIME(PARSE_TIMESTAMP('%Y%m%d%H%M%S', createTime))  AS inserted_at,
SAFE_CAST(brandId AS INT64) AS brandId,
porderId,
orderId,
rorderId,
applyTime,
returnTime,
lastModifyTime,
SAFE_CAST(refundStatus AS INT64) AS refundStatus,
SAFE_CAST(orderType AS INT64) AS orderType,
SAFE_CAST(returnSource AS INT64) AS returnSource,
SAFE_CAST(srcSystem AS INT64) AS srcSystem,
SAFE_CAST(returnType AS INT64) AS returnType,
SAFE_CAST(saleChannelId AS INT64) AS saleChannelId,
SAFE_CAST(saleChannelDjId AS INT64) AS saleChannelDjId,
saleChannelCode,
SAFE_CAST(saleShopDjId AS INT64) AS saleShopDjId,
saleShopCode,
SAFE_CAST(saleStaffDjId AS INT64) AS saleStaffDjId, 
saleStaffCode,
SAFE_CAST(deliverShopDjId AS INT64) AS deliverShopDjId,
deliverShopCode,
deliverChannelCode,
SAFE_CAST(deliverStaffDjId AS INT64) AS deliverStaffDjId,
deliverStaffCode,
SAFE_CAST(returnShopDjId AS INT64) AS returnShopDjId,
returnShopCode,
returnChannelCode,
SAFE_CAST(returnStaffDjId AS INT64) AS returnStaffDjId,
returnStaffCode,
SAFE_CAST(returnNum AS INT64) AS returnNum,
SAFE_CAST(sumSuggestPrice AS FLOAT64) AS sumSuggestPrice,
SAFE_CAST(returnMoney AS FLOAT64) AS returnMoney,
remark,
SAFE_CAST(returnOrderItems_rorderItemId AS INT64) AS returnOrderItems_rorderItemId,
SAFE_CAST(returnOrderItems_rorderId AS INT64) AS returnOrderItems_rorderId,
SAFE_CAST(returnOrderItems_spuDjId AS INT64) AS returnOrderItems_spuDjId,
returnOrderItems_spuCode,
SAFE_CAST(returnOrderItems_skuDjId AS INT64) AS returnOrderItems_skuDjId,
returnOrderItems_skuCode,
returnOrderItems_colorCode,
returnOrderItems_colorName,
returnOrderItems_sizeCode,
returnOrderItems_sizeName,
SAFE_CAST(returnOrderItems_returnAmount AS INT64) AS returnOrderItems_returnAmount,
SAFE_CAST(returnOrderItems_suggestPrice AS FLOAT64) AS returnOrderItems_suggestPrice,
SAFE_CAST(returnOrderItems_salePrice AS FLOAT64) AS returnOrderItems_salePrice,
SAFE_CAST(returnOrderItems_dealPrice AS FLOAT64) AS returnOrderItems_dealPrice,
SAFE_CAST(returnOrderItems_sumSuggestPrice AS FLOAT64) AS returnOrderItems_sumSuggestPrice,
SAFE_CAST(returnOrderItems_sumSalePrice AS FLOAT64) AS returnOrderItems_sumSalePrice,
SAFE_CAST(returnOrderItems_returnMoney AS FLOAT64) AS returnOrderItems_returnMoney,
SAFE_CAST(returnOrderItems_returnStaffId AS INT64) AS returnOrderItems_returnStaffId,
SAFE_CAST(returnOrderItems_returnStaffDjId AS INT64) AS returnOrderItems_returnStaffDjId,
returnOrderItems_returnStaffCode,
returnOrderItems_cashDtos,
returnOrderItems_uniqueCodes,
returnOrderItems_payInfo,
returnOrderItems_itemPayInfos_payMethodCode,
returnOrderItems_itemPayInfos_payMethodDesc,
returnOrderItems_itemPayInfos_custPayMethodCode,
returnOrderItems_itemPayInfos_custPayMethodName,
SAFE_CAST(returnOrderItems_itemPayInfos_amt AS FLOAT64) AS returnOrderItems_itemPayInfos_amt,
SAFE_CAST(returnOrderItems_itemPayInfos_totalAmt AS FLOAT64) AS returnOrderItems_itemPayInfos_totalAmt,
SAFE_CAST(serviceGuides_staffDjId AS INT64) AS serviceGuides_staffDjId,
serviceGuides_staffCode,
SAFE_CAST(payInfos_payType AS INT64) AS payInfos_payType,
payInfos_payCode,
payInfos_outPayChannelDesc,
SAFE_CAST(payInfos_amount AS FLOAT64) AS payInfos_amount,
SAFE_CAST(payInfos_otherAmount AS FLOAT64) AS payInfos_otherAmount,
payInfos_cashVoucherDtos,
SAFE_CAST(origOrder_orderId  AS INT64) AS origOrder_orderId,
SAFE_CAST(origOrder_sumAmount AS FLOAT64) AS origOrder_sumAmount,
SAFE_CAST(origOrder_sumSuggestPrice AS FLOAT64) AS origOrder_sumSuggestPrice,
SAFE_CAST(origOrder_sumSalePrice AS FLOAT64) AS origOrder_sumSalePrice,
SAFE_CAST(origOrder_sumDealPrice AS FLOAT64) AS origOrder_sumDealPrice
FROM ${ref("raw_dianplus_order_refund")}
WHERE TIMESTAMP_TRUNC(_PARTITIONTIME, DAY) = TIMESTAMP(CURRENT_DATE("Asia/Ho_Chi_Minh"))