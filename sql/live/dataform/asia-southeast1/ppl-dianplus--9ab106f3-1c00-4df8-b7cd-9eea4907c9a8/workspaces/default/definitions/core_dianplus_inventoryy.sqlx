config {
  type:"incremental",
  name:"core_dianplus_inventory",
  dependencyTargets:[{
    name:"stg_dianplus_inventory"
  }],
}
SELECT
  proc_date,
  DATE(inserted_at) AS updated_at, 
  brandId,
  warehouse_name,
  spuId, 
  spuCode, 
  skuId,
  REGEXP_EXTRACT(skuCode, r'^([^-]+)') AS product_code,
    DATE(
      SAFE_CAST(SUBSTR(REGEXP_EXTRACT(skuCode, r'\d{6}'), 1, 2) AS INT64) + 2000,
      SAFE_CAST(SUBSTR(REGEXP_EXTRACT(skuCode, r'\d{6}'), 3, 2) AS INT64),
      01
      ) product_launch_date, 
  skuCode, 
  realNum, 
  lockNum, 
  canUseNum, 
  frozenNum, 
  transitNum, 
  defectNum
  FROM ${ref("stg_dianplus_inventory")}
  WHERE DATE(proc_date) = DATE(CURRENT_DATE("Asia/Ho_Chi_Minh"))