config {
  type:"incremental",
  name:"core_dianplus_order",
  dependencyTargets:[{
    name:"stg_dianplus_order"
  }],
}
SELECT
  inserted_at,
  MAX(lastModifyTime) AS lastModifyTime ,
  brandId,
  orderId,
  payTime,
  orderType,
  orderStatus,
  payStatus,
  order_source_id,
  order_system_source_id,
  customId,
  customShopId,
  exclusiveGuideId,
  customShopCode,
  customLevelId,
  vipId,
  vipNum,
  vipMobilePhone,
  provinceCode,
  provinceName,
  cityCode,
  cityName,
  areaCode,
  areaName,
  sumAmount,
  sumSuggestPrice,
  sumSalePrice,
  sumDealPrice,
  brandDiscount,
  couponDiscount,
  moLingDiscount,
  customDiscount,
  integralDiscount,
  saleChannelDjId,
  saleChannelCode,
  saleShopId,
  saleShopDjId,
  saleShopCode,
  saleStaffDjId,
  createStaffDjId,
  createStaffCode,
  serviceGuides_staffName,
  serviceGuides_proportion,
  payInfos_payType,
  payInfos_payCode,
  payInfos_outPayChannelDesc,
  payInfos_amount,
  payInfos_otherAmount,
  couponAmount
  FROM ${ref("stg_dianplus_order")}
  WHERE DATE(proc_date) = CURRENT_DATE()
  GROUP BY
  inserted_at,
  brandId,
  orderId,
  payTime,
  orderType,
  orderStatus,
  payStatus,
  order_source_id,
  order_system_source_id,
  customId,
  customShopId,
  exclusiveGuideId,
  customShopCode,
  customLevelId,
  vipId,
  vipNum,
  vipMobilePhone,
  provinceCode,
  provinceName,
  cityCode,
  cityName,
  areaCode,
  areaName,
  sumAmount,
  sumSuggestPrice,
  sumSalePrice,
  sumDealPrice,
  brandDiscount,
  couponDiscount,
  moLingDiscount,
  customDiscount,
  integralDiscount,
  saleChannelDjId,
  saleChannelCode,
  saleShopId,
  saleShopDjId,
  saleShopCode,
  saleStaffDjId,
  createStaffDjId,
  createStaffCode,
  serviceGuides_staffName,
  serviceGuides_proportion,
  payInfos_payType,
  payInfos_payCode,
  payInfos_outPayChannelDesc,
  payInfos_amount,
  payInfos_otherAmount,
  couponAmount