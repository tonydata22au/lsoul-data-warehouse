config {
  type:"incremental",
  name:"stg_dianplus_order",
  dependencyTargets:[{
    name:"raw_dianplus_order"
  }],
}
SELECT
TIMESTAMP_TRUNC(_PARTITIONTIME, DAY) AS proc_date,
DATETIME(PARSE_TIMESTAMP('%Y%m%d%H%M%S', createTime))  AS inserted_at,
SAFE_CAST(brandId AS INT64) AS brandId,
orderId,
lastModifyTime,
payTime,
SAFE_CAST(orderType AS INT64) AS orderType,
SAFE_CAST(orderStatus AS INT64) AS orderStatus,
SAFE_CAST(payStatus AS INT64) AS payStatus,
SAFE_CAST(`source` AS INT64) AS order_source_id,
SAFE_CAST(srcSystem AS INT64) AS order_system_source_id,
customId,
customShopId,
exclusiveGuideId,
customShopCode,
customLevelId,
vipId,
SAFE_CAST(vipNum AS INT64) AS vipNum,
vipMobilePhone,
provinceCode,
provinceName,
cityCode,
cityName,
areaCode,
areaName,
SAFE_CAST(sumAmount AS FLOAT64) AS sumAmount,
SAFE_CAST(sumSuggestPrice AS FLOAT64) AS sumSuggestPrice,
SAFE_CAST(sumSalePrice AS FLOAT64) AS sumSalePrice,
SAFE_CAST(sumDealPrice AS FLOAT64) AS sumDealPrice,
SAFE_CAST(brandDiscount AS FLOAT64) AS brandDiscount,
SAFE_CAST(couponDiscount AS FLOAT64) AS couponDiscount,
SAFE_CAST(moLingDiscount AS FLOAT64) AS moLingDiscount,
SAFE_CAST(customDiscount AS FLOAT64) AS customDiscount,
SAFE_CAST(integralDiscount AS FLOAT64) AS integralDiscount,
SAFE_CAST(saleChannelDjId AS INT64) AS saleChannelDjId,
saleChannelCode,
SAFE_CAST(saleShopId AS INT64) AS saleShopId,
SAFE_CAST(saleShopDjId AS INT64) AS saleShopDjId,
saleShopCode,
SAFE_CAST(saleStaffDjId AS INT64) AS saleStaffDjId,
SAFE_CAST(createStaffDjId AS INT64) AS createStaffDjId,
createStaffCode,
SAFE_CAST(orderItems_orderItemId AS INT64) AS orderItems_orderItemId,
SAFE_CAST(orderItems_orderId AS INT64) AS orderItems_orderId,
SAFE_CAST(orderItems_spuDjId AS INT64) AS orderItems_spuDjId,
orderItems_spuCode,
SAFE_CAST(orderItems_skuDjId AS INT64) AS orderItems_skuDjId,
orderItems_skuCode,
orderItems_skuName,
orderItems_colorCode,
orderItems_colorName,
orderItems_sizeCode,
orderItems_sizeName,
SAFE_CAST(orderItems_amount AS INT64) AS orderItems_amount,
SAFE_CAST(orderItems_suggestPrice AS FLOAT64) AS orderItems_suggestPrice,
SAFE_CAST(orderItems_salePrice AS FLOAT64) AS orderItems_salePrice,
SAFE_CAST(orderItems_dealPrice AS FLOAT64) AS orderItems_dealPrice,
SAFE_CAST(orderItems_sumSuggestPrice AS FLOAT64) AS orderItems_sumSuggestPrice,
SAFE_CAST(orderItems_sumSalePrice AS FLOAT64) AS orderItems_sumSalePrice,
SAFE_CAST(orderItems_sumDealPrice AS FLOAT64) AS orderItems_sumDealPrice,
SAFE_CAST(orderItems_saleStaffDjId AS INT64) AS orderItems_saleStaffDjId,
orderItems_saleStaffCode,
orderItems_payInfo,
orderItems_itemPayInfos_payMethodCode,
orderItems_itemPayInfos_payMethodDesc,
orderItems_itemPayInfos_custPayMethodCode,
orderItems_itemPayInfos_custPayMethodName,
SAFE_CAST(orderItems_itemPayInfos_amt AS FLOAT64) AS orderItems_itemPayInfos_amt,
SAFE_CAST(orderItems_itemPayInfos_totalAmt AS FLOAT64) AS orderItems_itemPayInfos_totalAmt,
serviceGuides_staffName,
SAFE_CAST(serviceGuides_proportion AS FLOAT64) AS serviceGuides_proportion,
payInfos_payType,
payInfos_payCode,
payInfos_outPayChannelDesc,
SAFE_CAST(payInfos_amount AS FLOAT64) AS payInfos_amount,
SAFE_CAST(payInfos_otherAmount AS FLOAT64) AS payInfos_otherAmount,
SAFE_CAST(couponAmount AS FLOAT64) AS couponAmount
FROM ${ref("raw_dianplus_order")}
WHERE TIMESTAMP_TRUNC(_PARTITIONTIME, DAY) = TIMESTAMP(CURRENT_DATE("Asia/Ho_Chi_Minh"))