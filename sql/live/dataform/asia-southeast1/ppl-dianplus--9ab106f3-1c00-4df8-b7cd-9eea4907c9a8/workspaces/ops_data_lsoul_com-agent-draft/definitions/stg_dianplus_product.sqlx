config {
  type:"table",
  name:"stg_dianplus_product",
  dependencyTargets:[{
    name:"raw_dianplus_product"
  }],
}
SELECT
TIMESTAMP_TRUNC(_PARTITIONTIME, DAY) AS proc_date,
SAFE_CAST(brandId AS INT64) AS brandId,
SAFE_CAST(childBrandId AS INT64) AS childBrandId,
childBrandCode,
childBrandName,
SAFE_CAST(skuId AS INT64) AS skuId,
SAFE_CAST(spuId AS INT64) AS spuId,
SAFE_CAST(status AS INT64) AS status,
SAFE_CAST(lastModifyTime AS INT64) AS lastModifyTime,        
spuMerchantCode,
merchantCode,
standardCode,
title,
SAFE_CAST(catId AS INT64) AS catId,
catCode,
skuPropValList_propCode,
skuPropValList_groupName,
skuPropValList_valCode,
skuPropValList_valName,
SAFE_CAST(skuPropValList_valSort AS INT64) AS skuPropValList_valSort,
topCatName,
colorPropName,
colorCode,
colorName,
colorGroup,
SAFE_CAST(colorSort AS INT64) AS colorSort,
sizePropName,
sizeCode,
sizeName,
SAFE_CAST(sizeSort AS INT64) AS sizeSort,
SAFE_CAST(suggestPrice AS FLOAT64) AS suggestPrice,
SAFE_CAST(marketPrice AS FLOAT64) AS marketPrice,
SAFE_CAST(salePrice AS FLOAT64) AS salePrice,
SAFE_CAST(costPrice AS FLOAT64) AS costPrice,
SAFE_CAST(year AS INT64) AS year,
bigCat,
execStandard,
securityType,
mainFabric,
is_multiTopCat,   
is_oneTimesTitle,    
is_oneTimesSgtPrice,
is_oneTimesSalPrice
FROM ${ref("raw_dianplus_product")}
WHERE TIMESTAMP_TRUNC(_PARTITIONTIME, DAY) = TIMESTAMP(CURRENT_DATE("Asia/Ho_Chi_Minh"))