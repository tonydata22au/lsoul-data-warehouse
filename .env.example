# Copy this file to .env (gitignored) and fill in your local values.
# NEVER commit .env, service-account JSON keys, or real tokens.
#
# How values are read:
# - Pipeline scripts call load_dotenv(), which finds this repo-root .env when run locally.
#   Shell alternative: set -a; source .env; set +a
# - Deployed Cloud Run services must get these as service environment variables
#   (preferably Secret Manager references). A missing variable raises KeyError: '<NAME>'.
# See docs/setup.md for details.

# --- Google Cloud -------------------------------------------------------------
# Service-account key used by src/csv_export and src/schema. When unset, those scripts
# fall back to src/credentials/google-credentials.json (note: src/credentials/, not the
# repo-root credentials/ folder).
# src/local_run does NOT read this variable: it always loads the key from
# credentials/google-credentials.json in the repo root.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Source-system credentials ------------------------------------------------
# Pancake POS (pos.pages.fm)
PANCAKE_API_KEY=
# Dianplus (open.dianplus.cn)
DIANPLUS_APP_KEY=
DIANPLUS_APP_SECRET=
DIANPLUS_TOKEN=
# Jushuitan (openapi.jushuitan.com)
JUSHUITAN_APP_KEY=
JUSHUITAN_APP_SECRET=
# Magento (LSOUL website)
MAGENTO_USERNAME=
MAGENTO_PASSWORD=
# Surfosm / ScaleUp fulfilment (api-app.scaleup-fulfilment.com)
SURFOSM_API_KEY=
# Meta Graph API: Cloud Run Meta services and the csv_export Meta insight script
META_ACCESS_TOKEN=
# Meta Graph API: src/local_run/meta_ads_*.py (currently a different token)
META_ACCESS_TOKEN_LOCAL=
# TikTok Business API: Cloud Run VN services
TIKTOK_VN_ACCESS_TOKEN=
# TikTok Business API: Cloud Run Thai services
TIKTOK_TH_ACCESS_TOKEN=
# TikTok Business API: src/local_run and src/csv_export TikTok scripts
TIKTOK_ACCESS_TOKEN=

# --- Per-service overrides: do NOT set these globally ---------------------------
# BQ_DATASET and BQ_TABLE are read by both cr-magento-order.py and
# cr-surfosm-inventory.py; a value here would redirect BOTH services' loads.
# BQ_PROJECT is read only by cr-magento-order.py. cr-surfosm-inventory.py takes
# its project from GCP_PROJECT, then GOOGLE_CLOUD_PROJECT (HTTP requests only).
# Set these only on the individual Cloud Run service if needed.
# META_AD_ACCOUNT_ID is read by src/csv_export/CSV_V1_meta_ads_data_export_ads_insight.
